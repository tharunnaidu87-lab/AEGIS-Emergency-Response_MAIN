# Backend loads this directory's .env; shell variables take precedence.
# Copy this example to .env and replace placeholders locally. Never commit .env.
SARVAM_API_KEY=
NVIDIA_API_KEY=
AEGIS_DB_PATH=data/aegis.db
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AEGIS_ENABLE_RESET=false

# Authority-only Command Center authentication.
# Keep all real values only in backend/.env or the hosting provider's secret environment.
AEGIS_COMMAND_USERNAME=
AEGIS_COMMAND_PASSWORD=
AEGIS_COMMAND_AUTH_SECRET=

# Map local demo resource IDs to responder passwords (backend only).
# Use scripts/Start-Demo.ps1 for temporary local demo accounts. No production default.
AEGIS_RESPONDER_ACCOUNTS={}
