# Backend loads this directory's .env; shell variables take precedence.
# Copy this example to .env and replace placeholders locally. Never commit .env.
SARVAM_API_KEY=
NVIDIA_API_KEY=
AEGIS_DB_PATH=data/aegis.db
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AEGIS_ENABLE_RESET=false
